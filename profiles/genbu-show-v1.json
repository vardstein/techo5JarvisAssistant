{
  "product": "genbu-show-v1",
  "version": 1,
  "boards": [
    "crown",
    "checkers"
  ],
  "assistant": {
    "wake_word": "okay_nabu",
    "wake_fallbacks": [
      "hey_jarvis",
      "alexa"
    ],
    "wake_slots": 1,
    "brain_mode": "home-assistant",
    "follow_up_seconds": 6,
    "automatic_follow_ups": 2,
    "follow_up_tone": false,
    "stop_threshold": 0.55
  },
  "display": {
    "mode": "streamed",
    "path": "/jarvis-display",
    "idle": true,
    "headerless": true,
    "sidebarless": true
  },
  "security": {
    "house_announcements": "signed-only",
    "sip_transport": "tls",
    "sip_media": "srtp",
    "drop_in_default": false
  },
  "music": {
    "routing": "music-assistant",
    "room_primary_fallback": true,
    "named_groups": true,
    "group_membership": "resolve-on-explicit-play"
  }
}

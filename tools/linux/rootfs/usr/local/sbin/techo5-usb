#!/bin/sh
# techo5-usb on|off: USB debugging, run by the daemon (feature/security) when the switch changes.
# On, the port carries the root shell on serial and lets USB devices in; off, it does neither. The
# daemon keeps the flag boot.sh reads, so the choice holds from the start of the next boot.
log() { echo "techo5-usb: $*" > /dev/kmsg; }
[ -r /etc/techo5/device.conf ] && . /etc/techo5/device.conf
. /lib/techo5-lib.sh
case $1 in
on)
	t5_usb_acm
	t5_usb_host 1
	;;
off)
	t5_usb_off
	# The shell on the port ends with it, so nobody finds it still logged in when the port opens
	# again; init starts a fresh one, which asks for the password when one is set.
	# No console running is fine: a false test as the last command would be the script's exit
	# status, and the daemon would take the port for still open and retry every minute.
	p=$(cat /run/techo5/console.pid 2>/dev/null)
	if [ -n "$p" ]; then kill -HUP "$p" 2>/dev/null || :; fi
	;;
*)
	echo "usage: techo5-usb on|off" >&2
	exit 2
	;;
esac

#!/bin/sh
# The daemon under busybox init (inittab respawn). Waits for the network, then
# becomes techo5. init starts this again whenever it exits: after the daemon
# installed an update and stepped aside for the new binary, or after a crash.
# A trial binary that crashes is put back by the daemon's own next start (the
# marker in /run/techo5/prop survives the restart), so the loop here only has
# to be slow enough not to burn the CPU.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LOG=/data/techo5-linux/techo5.log

# Logs can contain household names, media URLs and network diagnostics. Keep the persistent runtime
# directory and every file created by this launcher root-only even on units upgraded from older
# images that used the system umask.
umask 077
ulimit -c 0 2>/dev/null || true
mkdir -p -m 700 /data/techo5-linux
chmod 700 /data/techo5-linux 2>/dev/null || true

# Maintenance: while /run/techo5/hold exists the daemon is not started, so the
# audio devices are free for audioprobe and the like. `rm` it to resume.
while [ -e /run/techo5/hold ]; do sleep 5; done

# An address is only on its way while the radio is associated and the lease is being asked for.
# The boot script has already waited out the association: with no network saved, or none in
# reach (the unit taken to another house), there is no address coming soon, and the screen is
# where one is chosen, so the daemon starts now rather than leave the bootloader's logo up for a
# minute and a half.
n=0
while [ $n -lt 90 ] && ! ip -4 addr show wlan0 2>/dev/null | grep -q inet; do
	wpa_cli -p /run/wpa -i wlan0 status 2>/dev/null | grep -q '^wpa_state=COMPLETED' || break
	sleep 1; n=$((n+1))
done
sleep 1

mkdir -p /data/misc/techo5/models
if [ -f $LOG ] && [ "$(stat -c %s $LOG 2>/dev/null || echo 0)" -gt 5000000 ]; then
	mv -f $LOG $LOG.1
fi
touch $LOG
chmod 600 $LOG $LOG.1 2>/dev/null || true
echo "techo5-run: starting $(/usr/local/bin/techo5 --version 2>/dev/null | head -1) at $(date)" >> $LOG
exec /usr/local/bin/techo5 run >> $LOG 2>&1
